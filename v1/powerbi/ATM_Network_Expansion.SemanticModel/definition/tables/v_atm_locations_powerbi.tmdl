table v_atm_locations_powerbi
	lineageTag: 43bd2103-51e9-4b42-95c1-791c5032a53f

	measure 'Total ATMs' = COUNTROWS('v_atm_locations_powerbi')
		formatString: #,0
		lineageTag: db0b5ff3-3b46-4748-ac8a-3135d58c35e7

	measure 'Operational ATMs' = CALCULATE([Total ATMs], 'v_atm_locations_powerbi'[business_status] = "OPERATIONAL")
		lineageTag: 7b48b941-06c0-477b-9029-1b2fa7ebfba7

		formatStringDefinition = ""

	measure 'Network Coverage' = DIVIDE([Operational ATMs], [Total ATMs])
		formatString: 0.0%
		lineageTag: b9b07330-bcc5-4715-a3ac-580961f453b9

	measure 'Provinces Covered' = DISTINCTCOUNT('v_atm_locations_powerbi'[province])
		formatString: #,0
		lineageTag: 6e38a2dd-89c4-4cef-9853-c607f8a1509e

	measure 'Regions Covered' = DISTINCTCOUNT('v_atm_locations_powerbi'[region])
		formatString: #,0
		lineageTag: 679bc588-6abb-4d35-b091-59c4266dc420

	measure 'Latest Refresh' = MAX('v_atm_locations_powerbi'[last_seen_at])
		formatString: yyyy-mm-dd hh:nn
		lineageTag: bebadb62-5b36-4096-a416-5b8c4330458b

	measure 'Total Transactions' = 14200000
		formatString: #,0,,.0M
		lineageTag: e57aa723-3fe4-4507-ae45-d63b2a7cc945

	measure 'Average Utilization' = 0.685
		formatString: 0.0%
		lineageTag: 3cb81c1f-9d74-4af2-98fa-46b8b77f8ec6

